# AITrader 环境变量配置
# 复制此文件为 .env 并填入你的 API 密钥

# LLM 周报（可选，不配置则跳过 AI 分析）
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# tushare 基本面数据（可选，不配置则用 baostock fallback）
TUSHARE_TOKEN=your_tushare_token_here

# Web 访问密码（可选，不配置则无需密码。部署到公网建议开启）
# AITRADER_USERNAME=admin
# AITRADER_PASSWORD=change_me

# ── 运行时（托管平台会自动注入，本地一般不用设） ──
# 可写数据目录：本地默认仓库根，平台注入 /data
# AITRADER_DATA_DIR=/data
# 时区：保证 datetime.now() 取的是 A 股交易日（容器默认 UTC 会错一天）
# TZ=Asia/Shanghai
# 部署版默认不跑进程内调度（平台会自动开），需要强制关闭时设 1
# AITRADER_DISABLE_SCHEDULER=1
