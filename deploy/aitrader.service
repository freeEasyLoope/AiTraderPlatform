[Unit]
Description=AITrader Web Dashboard
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/aitrader
EnvironmentFile=/opt/aitrader/.env
ExecStart=/opt/aitrader/.venv/bin/gunicorn src.web.main:app \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --access-logfile /opt/aitrader/logs/access.log \
    --error-logfile /opt/aitrader/logs/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
